# Existing public site
NEXT_PUBLIC_SITE_URL=https://scrap-finance-partners.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# Client workspace (Supabase Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only intake credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
LEAD_ORGANIZATION_ID=
LEAD_CREATED_BY_USER_ID=

# Guarded acquisition delivery
RESEND_API_KEY=
LEAD_FROM=
LEAD_TO=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
OUTREACH_PRIVACY_URL=https://scrap-finance-partners.vercel.app/privacy
OUTREACH_BATCH_LIMIT=10
ACQUISITION_COMMISSION_RATE=0.15
# The portal must remain in draft-only mode until this is explicitly true.
SEND_EMAILS_ENABLED=false
